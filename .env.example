# Local development only. Never commit real values.

# Optional; one of: local, staging, prod. Defaults to local when unset.
# Selects Mongo cluster URI and issuer_url — see design spec + docs/plans/technical.md (hosting notes).
# APP_ENV=local

# MongoDB Atlas (X.509 client cert; not SCRAM)
# Path to combined client certificate + private key (.pem).
# Optional; defaults to scratch/mongo-dev.pem when unset.
# MONGO_X509_CERT_PATH="/absolute/path/to/your-cert.pem"

# Cryptographic keys / secrets
TOKEN_SIGNING_KEY=
VAULT_MASTER_KEY=
TOKEN_EXCHANGE_SECRET=
SESSION_SECRET=

# Gmail SMTP (optional in local)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
